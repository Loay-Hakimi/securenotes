# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).

# Set to "production" for deployed environments (enables Secure cookies,
# requires a strong JWT_SECRET, trusts one proxy hop).
NODE_ENV=development

# Port the API listens on.
PORT=4000

# REQUIRED in production: a strong random secret (>=32 chars) for signing JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional overrides.
JWT_EXPIRES_IN=2h
DB_PATH=./data/securenotes.db
